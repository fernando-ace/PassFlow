# =============================================================================
# Authentication (choose ONE of the two options below)
# =============================================================================

# Playground fallback: use only while testing with the Ring Developer Playground.
# Generate it at: https://developer.amazon.com/ring/console/playground
# RING_ACCESS_TOKEN=replace_with_ring_playground_token

# Server-only HMAC secret for signing temporary PassFlow credentials.
# Generate at least 32 random characters. Never prefix this with NEXT_PUBLIC_.
PASSFLOW_SIGNING_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Ring Private App (server-only; never use NEXT_PUBLIC_ prefixes)
RING_CLIENT_ID=replace_with_ring_private_app_client_id
RING_CLIENT_SECRET=replace_with_ring_private_app_client_secret
RING_HMAC_KEY=replace_with_ring_private_app_hmac_key
# Base64URL-encoded 32-byte random key used for AES-256-GCM token encryption.
RING_TOKEN_ENCRYPTION_KEY=replace_with_base64url_32_byte_key

# Single-owner authentication for Ring's mandatory partner sign-in step.
RING_LINK_OWNER_EMAIL=replace_with_owner_email
RING_LINK_OWNER_PASSWORD=replace_with_a_unique_strong_password

# Durable Vercel PostgreSQL connection string. Apply db/migrations/001_ring_credentials.sql.
POSTGRES_URL=replace_with_vercel_postgres_connection_string

# Optional legacy refresh-token mode, separate from Ring Private App storage.
# RING_REFRESH_TOKEN=replace_with_refresh_token

# =============================================================================
# Device (optional — auto-discovered if not set)
# =============================================================================
# Device IDs are returned by the /v1/devices API. Run: python scripts/list_devices.py --token "..."
# RING_DEVICE_ID=your_device_id_here
# RING_DEVICE_NAME=Front Door

# =============================================================================
# Ring Private App webhooks use RING_HMAC_KEY above.
# =============================================================================
